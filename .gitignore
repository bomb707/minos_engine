# Ephemeral engine runtime (never committed).
# Anchored to the repo root so it does NOT match config dirs like configs/runtime/.
/runtime/

# Transient CI output (generated by the CI workflow, not versioned)
reports/ci-*.xml

# Large genomic / truth artifacts — MUST NOT be committed
*.bam
*.bai
*.cram
*.vcf
*.vcf.gz
*.vcf.gz.tbi
*.fa
*.fasta
*.fai
*.dict
*.sdf/
truth.*
mutations.*

