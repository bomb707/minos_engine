{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://minos.engine/schemas/feature-vector-v1.schema.json",
  "title": "L2-E Feature Vector v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "epoch",
    "dataset_id",
    "profile_id",
    "content_hash",
    "feature_values_hash",
    "partition",
    "snapshot_hash",
    "registry_hash",
    "feature_set_hash",
    "value_count",
    "values",
    "vector_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "feature-vector-v1"
    },
    "epoch": {
      "type": "integer",
      "minimum": 1
    },
    "dataset_id": {
      "type": "string",
      "minLength": 1
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "feature_values_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "partition": {
      "enum": [
        "train",
        "validation"
      ]
    },
    "snapshot_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "registry_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "feature_set_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "value_count": {
      "type": "integer",
      "exclusiveMinimum": 0
    },
    "values": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "number"
      }
    },
    "vector_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
