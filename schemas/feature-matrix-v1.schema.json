{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://minos.engine/schemas/feature-matrix-v1.schema.json",
  "title": "L2-E Logical Feature Matrix v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "epoch",
    "snapshot_hash",
    "partition",
    "registry_hash",
    "feature_set_hash",
    "row_count",
    "column_count",
    "members",
    "matrix_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "feature-matrix-v1"
    },
    "epoch": {
      "type": "integer",
      "minimum": 1
    },
    "snapshot_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "partition": {
      "enum": [
        "train",
        "validation"
      ]
    },
    "registry_hash": {
      "const": "0d8612707c6673060546511d8f5e8d1ba47048ef440e6c2dcf238fdc297f6e0c"
    },
    "feature_set_hash": {
      "const": "7e867dfa5633044b69869be8a87fac564431a73a183aa0ab0b1b13158a7c176f"
    },
    "row_count": {
      "type": "integer",
      "minimum": 0
    },
    "column_count": {
      "const": 129
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dataset_id",
          "vector_hash"
        ],
        "properties": {
          "dataset_id": {
            "type": "string",
            "minLength": 1
          },
          "vector_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "matrix_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
