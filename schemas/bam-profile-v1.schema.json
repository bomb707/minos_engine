{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://minos.engine/schemas/bam-profile-v1.schema.json",
  "title": "BAM profile v1",
  "$defs": {
    "AlignmentMetrics": {
      "additionalProperties": false,
      "properties": {
        "total_observed_alignments": {
          "minimum": 0,
          "title": "Total Observed Alignments",
          "type": "integer"
        },
        "included_primary_alignments": {
          "minimum": 0,
          "title": "Included Primary Alignments",
          "type": "integer"
        },
        "mapped_fraction": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Mapped Fraction",
          "type": "number"
        },
        "unmapped_fraction": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Unmapped Fraction",
          "type": "number"
        },
        "duplicate_fraction": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Duplicate Fraction",
          "type": "number"
        },
        "secondary_fraction": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Secondary Fraction",
          "type": "number"
        },
        "supplementary_fraction": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Supplementary Fraction",
          "type": "number"
        },
        "qcfail_fraction": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Qcfail Fraction",
          "type": "number"
        },
        "paired_fraction": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Paired Fraction",
          "type": "number"
        },
        "proper_pair_fraction": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Proper Pair Fraction",
          "type": "number"
        },
        "reverse_strand_fraction": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Reverse Strand Fraction",
          "type": "number"
        },
        "mate_unmapped_fraction": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Mate Unmapped Fraction",
          "type": "number"
        }
      },
      "required": [
        "total_observed_alignments",
        "included_primary_alignments",
        "mapped_fraction",
        "unmapped_fraction",
        "duplicate_fraction",
        "secondary_fraction",
        "supplementary_fraction",
        "qcfail_fraction",
        "paired_fraction",
        "proper_pair_fraction",
        "reverse_strand_fraction",
        "mate_unmapped_fraction"
      ],
      "title": "AlignmentMetrics",
      "type": "object"
    },
    "BamIdentity": {
      "additionalProperties": false,
      "properties": {
        "bam_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "title": "Bam Sha256",
          "type": "string"
        },
        "bam_size_bytes": {
          "exclusiveMinimum": 0,
          "title": "Bam Size Bytes",
          "type": "integer"
        },
        "header_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "title": "Header Sha256",
          "type": "string"
        },
        "index_status": {
          "$ref": "#/$defs/FieldStatus"
        },
        "index_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Index Sha256"
        },
        "reference_status": {
          "$ref": "#/$defs/FieldStatus"
        },
        "reference_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Sha256"
        },
        "fai_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fai Sha256"
        },
        "verification_strength": {
          "$ref": "#/$defs/VerificationStrength"
        }
      },
      "required": [
        "bam_sha256",
        "bam_size_bytes",
        "header_sha256",
        "index_status",
        "reference_status",
        "verification_strength"
      ],
      "title": "BamIdentity",
      "type": "object"
    },
    "BaseQualityMetrics": {
      "additionalProperties": false,
      "properties": {
        "bases_observed": {
          "minimum": 0,
          "title": "Bases Observed",
          "type": "integer"
        },
        "bases_with_quality": {
          "minimum": 0,
          "title": "Bases With Quality",
          "type": "integer"
        },
        "mean_base_quality_phred": {
          "minimum": 0.0,
          "title": "Mean Base Quality Phred",
          "type": "number"
        },
        "stddev_base_quality_phred": {
          "minimum": 0.0,
          "title": "Stddev Base Quality Phred",
          "type": "number"
        },
        "quantiles_phred": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Quantiles Phred",
          "type": "object"
        },
        "bq_lt20_fraction": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Bq Lt20 Fraction",
          "type": "number"
        },
        "missing_quality_fraction": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Missing Quality Fraction",
          "type": "number"
        }
      },
      "required": [
        "bases_observed",
        "bases_with_quality",
        "mean_base_quality_phred",
        "stddev_base_quality_phred",
        "quantiles_phred",
        "bq_lt20_fraction",
        "missing_quality_fraction"
      ],
      "title": "BaseQualityMetrics",
      "type": "object"
    },
    "CigarMetrics": {
      "additionalProperties": false,
      "properties": {
        "aligned_query_bases": {
          "minimum": 0,
          "title": "Aligned Query Bases",
          "type": "integer"
        },
        "soft_clipped_bases": {
          "minimum": 0,
          "title": "Soft Clipped Bases",
          "type": "integer"
        },
        "hard_clipped_bases": {
          "minimum": 0,
          "title": "Hard Clipped Bases",
          "type": "integer"
        },
        "inserted_bases": {
          "minimum": 0,
          "title": "Inserted Bases",
          "type": "integer"
        },
        "deleted_bases": {
          "minimum": 0,
          "title": "Deleted Bases",
          "type": "integer"
        },
        "skipped_bases": {
          "minimum": 0,
          "title": "Skipped Bases",
          "type": "integer"
        },
        "query_consuming_bases": {
          "minimum": 0,
          "title": "Query Consuming Bases",
          "type": "integer"
        },
        "soft_clipped_read_fraction": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Soft Clipped Read Fraction",
          "type": "number"
        },
        "soft_clipped_base_fraction": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Soft Clipped Base Fraction",
          "type": "number"
        },
        "indel_bearing_read_fraction": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Indel Bearing Read Fraction",
          "type": "number"
        },
        "nm_per_aligned_base": {
          "minimum": 0.0,
          "title": "Nm Per Aligned Base",
          "type": "number"
        },
        "nm_availability_fraction": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Nm Availability Fraction",
          "type": "number"
        },
        "cigar_ins_del_burden": {
          "minimum": 0.0,
          "title": "Cigar Ins Del Burden",
          "type": "number"
        }
      },
      "required": [
        "aligned_query_bases",
        "soft_clipped_bases",
        "hard_clipped_bases",
        "inserted_bases",
        "deleted_bases",
        "skipped_bases",
        "query_consuming_bases",
        "soft_clipped_read_fraction",
        "soft_clipped_base_fraction",
        "indel_bearing_read_fraction",
        "nm_per_aligned_base",
        "nm_availability_fraction",
        "cigar_ins_del_burden"
      ],
      "title": "CigarMetrics",
      "type": "object"
    },
    "CompletionReport": {
      "additionalProperties": false,
      "properties": {
        "completed_families": {
          "items": {
            "type": "string"
          },
          "title": "Completed Families",
          "type": "array"
        },
        "variant_evidence_completion": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Variant Evidence Completion",
          "type": "number"
        },
        "status": {
          "$ref": "#/$defs/ProfileStatus"
        }
      },
      "required": [
        "completed_families",
        "variant_evidence_completion",
        "status"
      ],
      "title": "CompletionReport",
      "type": "object"
    },
    "ConfidenceReport": {
      "additionalProperties": false,
      "properties": {
        "integrity": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Integrity",
          "type": "number"
        },
        "completeness": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Completeness",
          "type": "number"
        },
        "availability": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Availability",
          "type": "number"
        },
        "consistency": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Consistency",
          "type": "number"
        },
        "overall": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Overall",
          "type": "number"
        },
        "band": {
          "minLength": 1,
          "title": "Band",
          "type": "string"
        }
      },
      "required": [
        "integrity",
        "completeness",
        "availability",
        "consistency",
        "overall",
        "band"
      ],
      "title": "ConfidenceReport",
      "type": "object"
    },
    "CoverageMetrics": {
      "additionalProperties": false,
      "properties": {
        "fragment_primary": {
          "$ref": "#/$defs/CoverageView"
        },
        "duplicate_including": {
          "$ref": "#/$defs/CoverageView"
        },
        "deletion_aware_depth_recorded_separately": {
          "default": true,
          "title": "Deletion Aware Depth Recorded Separately",
          "type": "boolean"
        },
        "eligible_region_bases": {
          "minimum": 0,
          "title": "Eligible Region Bases",
          "type": "integer"
        }
      },
      "required": [
        "fragment_primary",
        "duplicate_including",
        "eligible_region_bases"
      ],
      "title": "CoverageMetrics",
      "type": "object"
    },
    "CoverageView": {
      "additionalProperties": false,
      "properties": {
        "view_name": {
          "minLength": 1,
          "title": "View Name",
          "type": "string"
        },
        "depth_semantics": {
          "minLength": 1,
          "title": "Depth Semantics",
          "type": "string"
        },
        "mean_depth_reads_per_base": {
          "minimum": 0.0,
          "title": "Mean Depth Reads Per Base",
          "type": "number"
        },
        "median_depth_reads_per_base": {
          "minimum": 0.0,
          "title": "Median Depth Reads Per Base",
          "type": "number"
        },
        "stddev_depth": {
          "minimum": 0.0,
          "title": "Stddev Depth",
          "type": "number"
        },
        "coefficient_of_variation": {
          "minimum": 0.0,
          "title": "Coefficient Of Variation",
          "type": "number"
        },
        "depth_mad": {
          "minimum": 0.0,
          "title": "Depth Mad",
          "type": "number"
        },
        "max_depth": {
          "minimum": 0,
          "title": "Max Depth",
          "type": "integer"
        },
        "zero_depth_fraction": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Zero Depth Fraction",
          "type": "number"
        },
        "depth_lt5_fraction": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Depth Lt5 Fraction",
          "type": "number"
        },
        "depth_lt10_fraction": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Depth Lt10 Fraction",
          "type": "number"
        },
        "depth_lt20_fraction": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Depth Lt20 Fraction",
          "type": "number"
        },
        "depth_gt50_fraction": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Depth Gt50 Fraction",
          "type": "number"
        },
        "depth_gt100_fraction": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Depth Gt100 Fraction",
          "type": "number"
        },
        "depth_gt200_fraction": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Depth Gt200 Fraction",
          "type": "number"
        },
        "callable_base_fraction": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Callable Base Fraction",
          "type": "number"
        },
        "depth_quantiles": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Depth Quantiles",
          "type": "object"
        }
      },
      "required": [
        "view_name",
        "depth_semantics",
        "mean_depth_reads_per_base",
        "median_depth_reads_per_base",
        "stddev_depth",
        "coefficient_of_variation",
        "depth_mad",
        "max_depth",
        "zero_depth_fraction",
        "depth_lt5_fraction",
        "depth_lt10_fraction",
        "depth_lt20_fraction",
        "depth_gt50_fraction",
        "depth_gt100_fraction",
        "depth_gt200_fraction",
        "callable_base_fraction",
        "depth_quantiles"
      ],
      "title": "CoverageView",
      "type": "object"
    },
    "DegradationRecord": {
      "additionalProperties": false,
      "properties": {
        "stage": {
          "$ref": "#/$defs/DegradationStage"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "trigger": {
          "minLength": 1,
          "title": "Trigger",
          "type": "string"
        },
        "omitted_features": {
          "items": {
            "type": "string"
          },
          "title": "Omitted Features",
          "type": "array"
        },
        "completed_features": {
          "items": {
            "type": "string"
          },
          "title": "Completed Features",
          "type": "array"
        },
        "elapsed_seconds": {
          "minimum": 0.0,
          "title": "Elapsed Seconds",
          "type": "number"
        },
        "remaining_seconds": {
          "title": "Remaining Seconds",
          "type": "number"
        },
        "usable": {
          "title": "Usable",
          "type": "boolean"
        },
        "status": {
          "$ref": "#/$defs/ProfileStatus"
        }
      },
      "required": [
        "stage",
        "reason",
        "trigger",
        "omitted_features",
        "completed_features",
        "elapsed_seconds",
        "remaining_seconds",
        "usable",
        "status"
      ],
      "title": "DegradationRecord",
      "type": "object"
    },
    "DegradationStage": {
      "enum": [
        "FULL",
        "REDUCED_PILEUP",
        "REDUCED_WINDOWS",
        "CORE_ONLY"
      ],
      "title": "DegradationStage",
      "type": "string"
    },
    "DifficultyVector": {
      "additionalProperties": false,
      "description": "Descriptive, versioned, monotonic risk transforms. Never a GATK recommendation.",
      "properties": {
        "transform_version": {
          "minLength": 1,
          "title": "Transform Version",
          "type": "string"
        },
        "mapping_risk": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Mapping Risk",
          "type": "number"
        },
        "coverage_risk": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Coverage Risk",
          "type": "number"
        },
        "base_quality_risk": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Base Quality Risk",
          "type": "number"
        },
        "complexity_risk": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Complexity Risk",
          "type": "number"
        },
        "reference_context_risk": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Reference Context Risk",
          "type": "number"
        }
      },
      "required": [
        "transform_version",
        "mapping_risk",
        "coverage_risk",
        "base_quality_risk",
        "complexity_risk",
        "reference_context_risk"
      ],
      "title": "DifficultyVector",
      "type": "object"
    },
    "FieldStatus": {
      "enum": [
        "available",
        "unavailable"
      ],
      "title": "FieldStatus",
      "type": "string"
    },
    "FilterCounts": {
      "additionalProperties": false,
      "description": "Mutually-exclusive read accounting: observed = included + \u03a3 excluded.",
      "properties": {
        "observed": {
          "minimum": 0,
          "title": "Observed",
          "type": "integer"
        },
        "included": {
          "minimum": 0,
          "title": "Included",
          "type": "integer"
        },
        "excluded_unmapped": {
          "minimum": 0,
          "title": "Excluded Unmapped",
          "type": "integer"
        },
        "excluded_secondary": {
          "minimum": 0,
          "title": "Excluded Secondary",
          "type": "integer"
        },
        "excluded_supplementary": {
          "minimum": 0,
          "title": "Excluded Supplementary",
          "type": "integer"
        },
        "excluded_duplicate": {
          "minimum": 0,
          "title": "Excluded Duplicate",
          "type": "integer"
        },
        "excluded_qcfail": {
          "minimum": 0,
          "title": "Excluded Qcfail",
          "type": "integer"
        },
        "excluded_below_mapq": {
          "minimum": 0,
          "title": "Excluded Below Mapq",
          "type": "integer"
        }
      },
      "required": [
        "observed",
        "included",
        "excluded_unmapped",
        "excluded_secondary",
        "excluded_supplementary",
        "excluded_duplicate",
        "excluded_qcfail",
        "excluded_below_mapq"
      ],
      "title": "FilterCounts",
      "type": "object"
    },
    "FragmentMetrics": {
      "additionalProperties": false,
      "properties": {
        "eligible_pair_count": {
          "minimum": 0,
          "title": "Eligible Pair Count",
          "type": "integer"
        },
        "template_length_policy": {
          "minLength": 1,
          "title": "Template Length Policy",
          "type": "string"
        },
        "mean_insert_size_bp": {
          "minimum": 0.0,
          "title": "Mean Insert Size Bp",
          "type": "number"
        },
        "stddev_insert_size_bp": {
          "minimum": 0.0,
          "title": "Stddev Insert Size Bp",
          "type": "number"
        },
        "insert_size_mad_bp": {
          "minimum": 0.0,
          "title": "Insert Size Mad Bp",
          "type": "number"
        },
        "quantiles_bp": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Quantiles Bp",
          "type": "object"
        },
        "overlapping_mate_fraction": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Overlapping Mate Fraction",
          "type": "number"
        },
        "abnormal_pair_fraction": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Abnormal Pair Fraction",
          "type": "number"
        }
      },
      "required": [
        "eligible_pair_count",
        "template_length_policy",
        "mean_insert_size_bp",
        "stddev_insert_size_bp",
        "insert_size_mad_bp",
        "quantiles_bp",
        "overlapping_mate_fraction",
        "abnormal_pair_fraction"
      ],
      "title": "FragmentMetrics",
      "type": "object"
    },
    "HeaderSummary": {
      "additionalProperties": false,
      "properties": {
        "hd_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hd Version"
        },
        "sort_order": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sort Order"
        },
        "contigs": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ],
            "type": "array"
          },
          "title": "Contigs",
          "type": "array"
        },
        "read_group_ids": {
          "items": {
            "type": "string"
          },
          "title": "Read Group Ids",
          "type": "array"
        },
        "sample_names": {
          "items": {
            "type": "string"
          },
          "title": "Sample Names",
          "type": "array"
        },
        "library_names": {
          "items": {
            "type": "string"
          },
          "title": "Library Names",
          "type": "array"
        },
        "platform_values": {
          "items": {
            "type": "string"
          },
          "title": "Platform Values",
          "type": "array"
        },
        "program_ids": {
          "items": {
            "type": "string"
          },
          "title": "Program Ids",
          "type": "array"
        },
        "coordinate_sorted": {
          "title": "Coordinate Sorted",
          "type": "boolean"
        },
        "has_nm_tag_observed": {
          "title": "Has Nm Tag Observed",
          "type": "boolean"
        },
        "has_md_tag_observed": {
          "title": "Has Md Tag Observed",
          "type": "boolean"
        }
      },
      "required": [
        "contigs",
        "read_group_ids",
        "sample_names",
        "library_names",
        "platform_values",
        "program_ids",
        "coordinate_sorted",
        "has_nm_tag_observed",
        "has_md_tag_observed"
      ],
      "title": "HeaderSummary",
      "type": "object"
    },
    "MappingQualityMetrics": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "mean": {
          "minimum": 0.0,
          "title": "Mean",
          "type": "number"
        },
        "stddev": {
          "minimum": 0.0,
          "title": "Stddev",
          "type": "number"
        },
        "minimum": {
          "minimum": 0.0,
          "title": "Minimum",
          "type": "number"
        },
        "maximum": {
          "minimum": 0.0,
          "title": "Maximum",
          "type": "number"
        },
        "quantiles": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Quantiles",
          "type": "object"
        },
        "mean_mapping_quality_phred": {
          "minimum": 0.0,
          "title": "Mean Mapping Quality Phred",
          "type": "number"
        },
        "mq0_fraction": {
          "maximum": 1.0,
          "minimum": 0.0,
