{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "layer2-feature-reconciliation-v1.schema.json",
  "title": "Layer 2 feature-registry reconciliation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "accepted_layer1_schema_hash",
    "accepted_profiler_config_hash",
    "registry_hash",
    "source_v2_results",
    "serialized_leaf_count",
    "analytical_scalar_count",
    "window_scalar_count",
    "container_count",
    "counts_by_state",
    "counts_by_value_kind",
    "missing_analytical_scalar_paths",
    "duplicate_analytical_scalar_paths",
    "unclassified_analytical_scalar_paths",
    "unknown_registry_scalar_paths",
    "non_scalar_model_feature_paths",
    "passed"
  ],
  "properties": {
    "schema_version": {"const": "layer2-feature-reconciliation-v1"},
    "accepted_layer1_schema_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "accepted_profiler_config_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "registry_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_v2_results": {"type": "string", "minLength": 1},
    "serialized_leaf_count": {"type": "integer", "minimum": 0},
    "analytical_scalar_count": {"type": "integer", "minimum": 0},
    "window_scalar_count": {"type": "integer", "minimum": 0},
    "container_count": {"type": "integer", "minimum": 0},
    "counts_by_state": {"type": "object", "additionalProperties": {"type": "integer"}},
    "counts_by_value_kind": {"type": "object", "additionalProperties": {"type": "integer"}},
    "missing_analytical_scalar_paths": {"type": "array", "items": {"type": "string"}},
    "duplicate_analytical_scalar_paths": {"type": "array", "items": {"type": "string"}},
    "unclassified_analytical_scalar_paths": {"type": "array", "items": {"type": "string"}},
    "unknown_registry_scalar_paths": {"type": "array", "items": {"type": "string"}},
    "non_scalar_model_feature_paths": {"type": "array", "items": {"type": "string"}},
    "data_dependent_container_parents": {"type": "array", "items": {"type": "string"}},
    "passed": {"type": "boolean"}
  }
}
