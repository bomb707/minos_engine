{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://minos.engine/schemas/feature-set-v1.schema.json",
  "title": "L2-E Feature Set Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_hash",
    "column_count",
    "columns",
    "feature_set_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "feature-set-v1"
    },
    "registry_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "column_count": {
      "type": "integer",
      "exclusiveMinimum": 0
    },
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index",
          "path",
          "source_schema",
          "state",
          "value_kind"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "source_schema": {
            "const": "bam-profile-v1"
          },
          "state": {
            "const": "ELIGIBLE"
          },
          "value_kind": {
            "enum": [
              "REAL",
              "FRACTION",
              "COUNT"
            ]
          }
        }
      }
    },
    "feature_set_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
