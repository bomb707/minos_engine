{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://minos.engine/schemas/twin-parity-report-v1.schema.json",
  "title": "TwinParityReport v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "declared_level", "matched", "differences", "created_at"],
  "properties": {
    "schema_version": { "const": "twin-parity-report-v1" },
    "name": { "type": "string", "minLength": 1 },
    "declared_level": { "enum": ["STRUCTURAL", "FIXTURE_REPLAY", "TOOL_EXECUTION", "VALIDATOR_CONFIRMED"] },
    "matched": { "type": "boolean" },
    "differences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "kind"],
        "properties": {
          "field": { "type": "string", "minLength": 1 },
          "kind": {
            "enum": [
              "MISSING_EXPECTED", "UNEXPECTED", "HASH_MISMATCH",
              "VALUE_MISMATCH", "TOOL_VERSION_MISMATCH", "PROTOCOL_VERSION_MISMATCH"
            ]
          },
          "expected": { "type": ["string", "null"] },
          "observed": { "type": ["string", "null"] }
        }
      }
    },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
