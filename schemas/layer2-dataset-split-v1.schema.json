{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://minos.engine/schemas/layer2-dataset-split-v1.schema.json",
  "title": "Layer 2 Dataset Split Manifest v1",
  "description": "Immutable dataset registry + deterministic 50/10/15 split manifest (L2-C). Purely deterministic content: no timestamps, git sha, absolute paths, or truth/mutation information.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "split_algorithm",
    "salt",
    "split_policy_version",
    "split_policy_hash",
    "counts",
    "per_chromosome",
    "parameter_space_hash",
    "feature_registry_hash",
    "dataset_registry_hash",
    "samples",
    "manifest_hash"
  ],
  "properties": {
    "schema_version": { "const": "layer2-dataset-split-v1" },
    "split_algorithm": { "const": "hash-stratified" },
    "salt": { "type": "string", "minLength": 1 },
    "split_policy_version": { "type": "string", "minLength": 1 },
    "split_policy_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["train", "validation", "test"],
      "properties": {
        "train": { "type": "integer", "minimum": 0 },
        "validation": { "type": "integer", "minimum": 0 },
        "test": { "type": "integer", "minimum": 0 }
      }
    },
    "per_chromosome": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["train", "validation", "test"],
        "properties": {
          "train": { "type": "integer", "minimum": 0 },
          "validation": { "type": "integer", "minimum": 0 },
          "test": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "parameter_space_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "feature_registry_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "dataset_registry_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "manifest_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dataset_id",
          "round_id",
          "chromosome",
          "region_source",
          "region_contig",
          "region_start0",
          "region_end0_exclusive",
          "region_length_bp",
          "region_coordinate_system",
          "region_hash",
          "bam_sha256",
          "bai_sha256",
          "reference_sha256",
          "fai_sha256",
          "bam_size_bytes",
          "parameter_space_hash",
          "feature_registry_hash",
          "identity_tuple_hash",
          "split_algorithm_version",
          "split_salt",
          "allocation_digest",
          "partition",
          "sort_order"
        ],
        "properties": {
          "dataset_id": { "type": "string", "minLength": 1 },
          "round_id": { "type": "string", "pattern": "^[0-9a-f]+$" },
          "chromosome": { "enum": ["chr18", "chr19", "chr20", "chr21", "chr22"] },
          "region_source": { "type": "string", "minLength": 1 },
          "region_contig": { "enum": ["chr18", "chr19", "chr20", "chr21", "chr22"] },
          "region_start0": { "type": "integer", "minimum": 0 },
          "region_end0_exclusive": { "type": "integer", "exclusiveMinimum": 0 },
          "region_length_bp": { "type": "integer", "exclusiveMinimum": 0 },
          "region_coordinate_system": { "const": "zero_based_half_open" },
          "region_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "bam_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "bai_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "reference_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "fai_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "bam_size_bytes": { "type": "integer", "minimum": 0 },
          "parameter_space_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "feature_registry_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "identity_tuple_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "split_algorithm_version": { "type": "string", "minLength": 1 },
          "split_salt": { "type": "string", "minLength": 1 },
          "allocation_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "partition": { "enum": ["train", "validation", "test"] },
          "sort_order": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
