  "cutover_mapping": {
    "executed_in": "a later stage, not D1.1 and not D2",
    "postgresql_dependency_analysis": {
      "consequence": "Every SECURITY DEFINER function, every SET search_path and every textual object reference must be re-created or re-verified as part of the cutover transaction, not assumed correct. This is why step 5 exists and why a rename alone is not a cutover.",
      "renames_that_do_NOT_follow_automatically": [
        "A function body is stored as TEXT and is re-parsed at execution time: a schema-qualified reference inside a SECURITY DEFINER body keeps naming the OLD schema after a rename and will silently resolve to the retired V1 object.",
        "SET search_path attached to a function, a role or the database names schemas as strings and does not follow a rename.",
        "regclass and regprocedure values stored as TEXT rather than as the regclass type.",
        "Any schema name embedded in application SQL or configuration."
      ],
      "renames_that_follow_automatically": [
        "Foreign keys, indexes, sequences, primary keys and check constraints track their table by OID, so a schema rename does not break them.",
        "Views and column defaults parsed into stored parse trees track referenced objects by OID as well."
      ]
    },
    "preconditions": [
      "Application writes stopped and active transactions drained.",
      "A complete recovery set verified: the database backup AND its artifact snapshot.",
      "Every D3 validation query green."
    ],
    "revalidation_targets": [
      "foreign keys resolve to the renamed schemas",
      "function bodies and their SET search_path clauses",
      "trigger definitions and the functions they call",
      "grants on every renamed object",
      "database, role and session search_path configuration",
      "regclass / regprocedure literals stored in catalogs or column defaults",
      "SQL text embedded in views, defaults, check constraints and function bodies",
      "repository-side schema resolution in the application"
    ],
